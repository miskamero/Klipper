root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,scss,css,json,html}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.rs]
# Keep rustfmt's standard indentation.
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[package-lock.json]
indent_style = space
indent_size = 2
